# Copy to .env, enter your key, then export these values before starting Python.
# Default: Meta Model API (works with a Meta key from dev.meta.ai).
# Verified 2026-10-28: real scans of all three fixtures returned "verified".
# Optional hackathon open model, ONLY with a Baseten key (a Meta key gets 403 there,
# and api.meta.ai answers 404 model_not_found for it):
#   META_MUSE_BASE_URL=https://api.meta.ai/v1
#   META_MUSE_RED_MODEL=meta-models/muse-spark-open-1026
#   META_MUSE_BLUE_MODEL=meta-models/muse-spark-open-1026
META_MUSE_API_KEY=
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_RED_MODEL=muse-spark-1.3
META_MUSE_BLUE_MODEL=muse-wonder-1.0
META_MUSE_TIMEOUT_SECONDS=180
# Reasoning tokens count toward this output budget. 8192 truncated real responses.
META_MUSE_MAX_TOKENS=32768
# Optional: minimal | low | medium | high | xhigh | max. Unset = model default.
META_MUSE_REASONING_EFFORT=
PURPLEBOX_VERIFIER_TIMEOUT_SECONDS=20
# hosted (default) requires a key and explicit project-source consent.
# For fully local Muse inference, prepare a compatible local server first:
# PURPLEBOX_INFERENCE_MODE=local
# META_MUSE_BASE_URL=http://127.0.0.1:8081/v1
# META_MUSE_RED_MODEL=meta-models/muse-spark-open-1026
# META_MUSE_BLUE_MODEL=meta-models/muse-spark-open-1026
PURPLEBOX_INFERENCE_MODE=hosted
