# Copy to .env, enter your key, then export these values before starting Python.
# Hackathon default: Muse Spark Open (meta-models/muse-spark-open-1026) on Baseten.
# META_MUSE_API_KEY is your Baseten API key (app.baseten.co, Settings -> API Keys).
# Meta Model API instead: META_MUSE_BASE_URL=https://api.meta.ai/v1 with
# muse-spark-1.3 / muse-wonder-1.0 and a Meta Model API key.
META_MUSE_API_KEY=
META_MUSE_BASE_URL=https://inference.baseten.co/v1
META_MUSE_RED_MODEL=meta-models/muse-spark-open-1026
META_MUSE_BLUE_MODEL=meta-models/muse-spark-open-1026
META_MUSE_TIMEOUT_SECONDS=180
# Reasoning tokens count toward this output budget. 8192 truncated real responses.
META_MUSE_MAX_TOKENS=32768
# Optional: minimal | low | medium | high | xhigh | max. Unset = model default.
META_MUSE_REASONING_EFFORT=
PURPLEBOX_VERIFIER_TIMEOUT_SECONDS=20
