# Copy to .env, enter your key, then export these values before starting Python.
# Default: Meta Model API (works with a Meta key from dev.meta.ai).
# Verified 2026-10-28: real scans of all three fixtures returned "verified".
# Optional hackathon open model, ONLY with a Baseten key (a Meta key gets 403 there,
# and api.meta.ai answers 404 model_not_found for it):
#   META_MUSE_BASE_URL=https://api.meta.ai/v1
#   META_MUSE_RED_MODEL=meta-models/muse-spark-open-1026
#   META_MUSE_BLUE_MODEL=meta-models/muse-spark-open-1026
META_MUSE_API_KEY=
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_RED_MODEL=muse-spark-1.3-contributor
META_MUSE_BLUE_MODEL=muse-wonder-1.0
META_MUSE_TIMEOUT_SECONDS=300
# Reasoning tokens count toward this output budget. 8192 truncated real responses.
META_MUSE_MAX_TOKENS=32768
# Optional: minimal | low | medium | high | xhigh | max. Unset = model default.
META_MUSE_REASONING_EFFORT=
PURPLEBOX_VERIFIER_TIMEOUT_SECONDS=20
# hosted (default) requires a key and explicit project-source consent.
# For fully local Muse inference, prepare a compatible local server first:
# PURPLEBOX_INFERENCE_MODE=local
# META_MUSE_BASE_URL=http://127.0.0.1:8081/v1
# META_MUSE_RED_MODEL=meta-models/muse-spark-open-1026
# META_MUSE_BLUE_MODEL=meta-models/muse-spark-open-1026
PURPLEBOX_INFERENCE_MODE=hosted
# Observability verbosity: dev records ~10x detail records per milestone,
# prod records milestones only (default: prod).
PURPLEBOX_OBSERVABILITY_MODE=prod
# Optional opt-in vulnerability-intel enrichment: off unless "on".
# PURPLEBOX_RESEARCH=off
# Comma-separated subset of: trivy, grype, osv-scanner, dependency-check,
# dependency-track. Unknown names fail closed at startup.
# PURPLEBOX_RESEARCH_SCANNERS=
# Docker operation timeout seconds (1-600, default 30). Out of range fails at startup.
# PURPLEBOX_DOCKER_TIMEOUT_SECONDS=120
# Offline intel: "1"/"true"/"on" skips all network intel lookups (cache only).
# PURPLEBOX_INTEL_OFFLINE=
# Dependency-Track server URL for the dependency-track scanner transport.
# PURPLEBOX_DTRACK_URL=
# Dependency-Track API key (secret; keep it in .env only, never commit).
# PURPLEBOX_DTRACK_API_KEY=
# Optional NVD API key for higher NVD rate limits (secret).
# NVD_API_KEY=
# Override directory for the local intel/finding vault.
# PURPLEBOX_VAULT_DIR=
# DEBUG ONLY: writes raw model responses to disk. Never enable in shared environments.
# PURPLEBOX_LOG_RAW_RESPONSES=

# Container budget (real repos need headroom: 256m OOMs a python http.server on big trees)
PURPLEBOX_CONTAINER_MEM_LIMIT=1g
PURPLEBOX_CONTAINER_CPU_NANO=500000000
