FROM python:3.12-alpine3.22
RUN apk add --no-cache nodejs php84 \
    && ln -s /usr/bin/php84 /usr/local/bin/php \
    && addgroup -g 10001 purplebox \
    && adduser -D -u 10001 -G purplebox purplebox \
    && mkdir -p /workspace /verifier \
    && chown -R 10001:10001 /workspace /verifier
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace
USER 10001:10001
CMD ["python3", "-c", "print('Use the Secure Mitigation System orchestrator to start a fixture.')"]
