FROM python:3.12-alpine3.22@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322
# Clone-only base: git with a locked apk version on the same pinned base as
# the other purplebox images (brief 2026-11-03-repo-intake-live, D1).
# The target/verifier images deliberately lack git; clone traffic never
# shares a container with probe execution.
RUN apk add --no-cache git=2.49.1-r0 \
    && addgroup -g 10001 purplebox \
    && adduser -D -u 10001 -G purplebox purplebox \
    && mkdir -p /work \
    && chown -R 10001:10001 /work
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GIT_TERMINAL_PROMPT=0 GIT_LFS_SKIP_SMUDGE=1
WORKDIR /work
USER 10001:10001
CMD ["git", "--version"]
