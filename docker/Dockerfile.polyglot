# MISSION OMNI-INGEST Wave 2 (DynamicProvisioner): thick polyglot image.
# Same pinned base digest as Dockerfile.target (python:3.12-alpine3.22).
# Build toolchains (gcc/make/cmake) + Go + Rust via pinned apk packages
# (versions verified live 2026-11-04 against python:3.12-alpine3.22:
# gcc-14.2.0-r6, make-4.4.1-r3, cmake-3.31.7-r1, go-1.24.13-r0,
# rust-1.87.0-r1, cargo-1.87.0-r1). Node + php + openssl mirror the
# target image so web trees run unchanged. Non-root uid 10001, same
# /workspace layout. Wave 2 provisioning runs `apk add` stages with
# network attached for per-ecosystem extras (e.g. go mod download),
# then the execution wave re-attaches with network NONE (LAW 2).
FROM python:3.12-alpine3.22@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322
RUN apk add --no-cache \
    nodejs=22.23.4-r0 php84=8.4.27-r0 openssl=3.5.9-r0 \
    gcc=14.2.0-r6 make=4.4.1-r3 cmake=3.31.7-r1 \
    go=1.24.13-r0 rust=1.87.0-r1 cargo=1.87.0-r1 \
    && ln -s /usr/bin/php84 /usr/local/bin/php \
    && addgroup -g 10001 purplebox \
    && adduser -D -u 10001 -G purplebox purplebox \
    && mkdir -p /workspace /verifier \
    && chown -R 10001:10001 /workspace /verifier
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ENV PATH="/usr/local/go/bin:/root/.cargo/bin:${PATH}"
WORKDIR /workspace
USER 10001:10001
CMD ["python3", "-c", "print('Use the Secure Mitigation System orchestrator to start a fixture.')"]
