FROM python:3.12-alpine3.22@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322
# Wave 8 item 8 (llama): base digest verified offline via
# `docker inspect python:3.12-alpine3.22` (RepoDigests) on 2026-10-29.
# No apk packages on this image, so nothing further to lock.
RUN addgroup -g 10001 purplebox \
    && adduser -D -u 10001 -G purplebox purplebox \
    && mkdir -p /verifier /workspace \
    && chown -R 10001:10001 /verifier /workspace
COPY --chown=10001:10001 runner.py /verifier/runner.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /verifier
USER 10001:10001
CMD ["python3", "/verifier/runner.py"]
